<Window x:Class="HSTemplate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HSTemplate"
        Width="1040"
        Height="680"
        MinWidth="800"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource HsBackgroundBrush}"
        FontFamily="Segoe UI"
        FontSize="13">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="92" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource HsHeaderBrush}">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="36" Height="36" CornerRadius="8"
                        Background="{DynamicResource HsAccentBrush}"
                        VerticalAlignment="Center">
                    <TextBlock Text="HS" Foreground="White" FontWeight="Bold" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="AppNameTextBlock" Foreground="White" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock x:Name="AppDescriptionTextBlock" Foreground="#B9C3D6" FontSize="12" Margin="0,4,0,0" />
                </StackPanel>

                <Border Grid.Column="2" Background="{DynamicResource HsHeaderSurfaceBrush}"
                        CornerRadius="12" Padding="10,5" VerticalAlignment="Center">
                    <TextBlock x:Name="VersionTextBlock" Foreground="#D9E0EC" FontSize="12" />
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" MinWidth="250" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource HsCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Primary workspace" Style="{StaticResource HsSectionTitleTextStyle}" />
                        <TextBlock Text="Replace this card with the application's main task. Keep the suite shell, spacing and control styles."
                                   Style="{StaticResource HsSecondaryTextStyle}" Margin="0,6,0,20" />

                        <TextBlock Text="Example input" FontWeight="SemiBold" Margin="0,0,0,7" />
                        <TextBox x:Name="ExampleInputTextBox" Style="{StaticResource HsTextBoxStyle}"
                                 Text="HSSuite starter" Margin="0,0,0,16" />

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Primary action" Style="{StaticResource HsPrimaryButtonStyle}"
                                    Click="PrimaryAction_Click" />
                            <Button Content="Secondary" Style="{StaticResource HsSecondaryButtonStyle}"
                                    Margin="10,0,0,0" Click="SecondaryAction_Click" />
                        </StackPanel>

                        <ProgressBar x:Name="ExampleProgressBar" Style="{StaticResource HsProgressBarStyle}"
                                     Minimum="0" Maximum="100" Value="38" Margin="0,24,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource HsCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Suite baseline" Style="{StaticResource HsSectionTitleTextStyle}" />
                        <TextBlock Text="Recognizable shell, independent product."
                                   Style="{StaticResource HsSecondaryTextStyle}" Margin="0,6,0,18" />

                        <Border Background="{DynamicResource HsAccentSoftBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Compatibility" FontWeight="SemiBold" Foreground="{DynamicResource HsPrimaryTextBrush}" />
                                <TextBlock Text="WPF · .NET Framework 4.7.2 · no NuGet by default"
                                           Style="{StaticResource HsSecondaryTextStyle}" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource HsSuccessSoftBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Output" FontWeight="SemiBold" Foreground="{DynamicResource HsSuccessBrush}" />
                                <TextBlock Text="Generated files default beside the EXE and never silently overwrite."
                                           Style="{StaticResource HsSecondaryTextStyle}" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource HsWarningSoftBrush}" CornerRadius="6" Padding="12">
                            <StackPanel>
                                <TextBlock Text="Product rules" FontWeight="SemiBold" Foreground="{DynamicResource HsWarningBrush}" />
                                <TextBlock Text="Define read/write/mutation permissions separately for each application."
                                           Style="{StaticResource HsSecondaryTextStyle}" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource HsSurfaceBrush}"
                BorderBrush="{DynamicResource HsBorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusTextBlock" Text="Bereit" FontSize="12"
                           Foreground="{DynamicResource HsSecondaryTextBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="HSSuite" FontSize="12"
                           Foreground="{DynamicResource HsMutedTextBrush}" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
