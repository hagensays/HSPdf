<Window x:Class="HSPdf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HSPdf"
        Width="1120"
        Height="780"
        MinWidth="720"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource HsBackgroundBrush}"
        FontFamily="Segoe UI"
        FontSize="13"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded"
        Closed="Window_Closed"
        AllowDrop="True"
        Drop="Window_Drop">
    <Window.Resources>
        <Style x:Key="PdfToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource HsSecondaryButtonStyle}">
            <Setter Property="Width" Value="54" />
            <Setter Property="MinWidth" Value="54" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="3,0" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="PdfToolbarPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource HsPrimaryButtonStyle}">
            <Setter Property="Width" Value="54" />
            <Setter Property="MinWidth" Value="54" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="3,0" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource HsHeaderBrush}">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="36" Height="36" CornerRadius="8"
                        Background="{DynamicResource HsAccentBrush}"
                        VerticalAlignment="Center">
                    <TextBlock Text="HS" Foreground="White" FontWeight="Bold" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="AppNameTextBlock" Foreground="White" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock x:Name="AppDescriptionTextBlock" Foreground="#B9C3D6" FontSize="12" Margin="0,3,0,0" />
                </StackPanel>
                <Border Grid.Column="2" Background="{DynamicResource HsHeaderSurfaceBrush}"
                        CornerRadius="12" Padding="10,5" VerticalAlignment="Center">
                    <TextBlock x:Name="VersionTextBlock" Foreground="#D9E0EC" FontSize="12" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource HsSurfaceBrush}"
                    BorderBrush="{DynamicResource HsBorderBrush}" BorderThickness="0,0,1,0">
                <StackPanel Margin="8,12,8,8">
                    <Button Content="Open" Style="{StaticResource PdfToolbarPrimaryButtonStyle}"
                            ToolTip="PDF öffnen · Ctrl+O" Click="OpenButton_Click" />
                    <Separator Margin="0,0,0,10" />
                    <Button x:Name="PreviousButton" Content="Prev" Style="{StaticResource PdfToolbarButtonStyle}"
                            ToolTip="Vorherige Seite · Page Up / Links" Click="PreviousButton_Click" />
                    <Button x:Name="NextButton" Content="Next" Style="{StaticResource PdfToolbarButtonStyle}"
                            ToolTip="Nächste Seite · Page Down / Rechts" Click="NextButton_Click" />
                    <Separator Margin="0,0,0,10" />
                    <Button x:Name="ZoomInButton" Content="+" Style="{StaticResource PdfToolbarButtonStyle}"
                            ToolTip="Vergrößern · +" Click="ZoomInButton_Click" />
                    <Button x:Name="ZoomOutButton" Content="−" Style="{StaticResource PdfToolbarButtonStyle}"
                            ToolTip="Verkleinern · -" Click="ZoomOutButton_Click" />
                    <Button x:Name="FitHeightButton" Content="Fit H" Style="{StaticResource PdfToolbarButtonStyle}"
                            ToolTip="Auf Höhe einpassen · H" Click="FitHeightButton_Click" />
                    <Button x:Name="FitWidthButton" Content="Fit W" Style="{StaticResource PdfToolbarButtonStyle}"
                            ToolTip="Auf Breite einpassen · W" Click="FitWidthButton_Click" />
                    <Button x:Name="RotateButton" Content="Rot" Style="{StaticResource PdfToolbarButtonStyle}"
                            ToolTip="90° im Uhrzeigersinn · R" Click="RotateButton_Click" />
                </StackPanel>
            </Border>

            <ScrollViewer x:Name="PdfScrollViewer" Grid.Column="1"
                          Background="#E5E8ED"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalContentAlignment="Stretch"
                          VerticalContentAlignment="Stretch"
                          PreviewMouseWheel="PdfScrollViewer_PreviewMouseWheel"
                          SizeChanged="PdfScrollViewer_SizeChanged">
                <Grid x:Name="PdfCanvas" Margin="24" MinWidth="200" MinHeight="200">
                    <StackPanel x:Name="EmptyStatePanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="PDF öffnen" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{DynamicResource HsPrimaryTextBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="Ctrl+O oder PDF hier hineinziehen"
                                   Style="{StaticResource HsSecondaryTextStyle}" Margin="0,6,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                    <Border x:Name="PageBorder" Visibility="Collapsed"
                            Background="White" BorderBrush="#C9CED8" BorderThickness="1"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image x:Name="PdfImage" Stretch="None" SnapsToDevicePixels="True" UseLayoutRounding="True" />
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource HsSurfaceBrush}"
                BorderBrush="{DynamicResource HsBorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusTextBlock" Text="Bereit · PDF öffnen" FontSize="12"
                           Foreground="{DynamicResource HsSecondaryTextBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="ContextTextBlock" Grid.Column="1" Text="Kein Dokument" FontSize="12"
                           Foreground="{DynamicResource HsMutedTextBrush}" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
